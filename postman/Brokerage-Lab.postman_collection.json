          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const cases = pm.response.json().breaks;",
              "pm.test(\"One OPEN mismatch\", () => { pm.expect(cases.length).to.eql(1); pm.expect(cases[0].category).to.eql(\"AMOUNT_MISMATCH\"); pm.expect(cases[0].status).to.eql(\"OPEN\"); });",
