              "pm.test(\"Cash 200, reserved 0, available 200\", () => { const body = pm.response.json(); pm.expect(body.posted_cash).to.eql(\"200.00\"); pm.expect(body.active_reservations).to.eql(\"0.00\"); pm.expect(body.available_cash).to.eql(\"200.00\"); });"
            ]
