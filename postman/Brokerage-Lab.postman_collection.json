{
  "info": {
    "name": "Brokerage Lab \u2014 executable acceptance walkthrough",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order against the local development lab. Credentials are environment variables. Creates fresh scenario accounts; never resets existing data. Scenario scripts verify persisted outcomes."
  },
  "variable": [
    {
      "key": "run_id",
      "value": ""
    },
    {
      "key": "account_id",
      "value": ""
    },
    {
      "key": "order_id",
      "value": ""
    },
    {
      "key": "request_key",
      "value": ""
    },
    {
      "key": "reconciliation_id",
      "value": ""
    },
    {
      "key": "break_id",
      "value": ""
    },
    {
      "key": "replay_body",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Liveness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health/live"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Readiness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health/ready"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Missing credentials",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/demo/account"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Create isolated retry-storm run",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Operator-Key",
            "value": "{{operator_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/lab/runs",
        "body": {
          "mode": "raw",
          "raw": "{\"scenario\": \"retry_storm\", \"seed\": 42}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const run = pm.response.json();",
              "pm.test(\"Scenario passed\", () => pm.expect(run.status).to.eql(\"PASSED\"));",
              "pm.collectionVariables.set(\"run_id\", run.run_id);",
              "pm.collectionVariables.set(\"account_id\", run.evidence.final.account_id);",
              "pm.collectionVariables.set(\"order_id\", run.evidence.final.orders[0].id);",
              "pm.collectionVariables.set(\"request_key\", run.run_id + \":intent\");",
              "pm.test(\"20 requests, one order\", () => { pm.expect(run.evidence.requests).to.eql(20); pm.expect(run.evidence.distinct_order_ids).to.eql(1); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Replay committed order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{client_key}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{request_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/accounts/{{account_id}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"quantity\": 8}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Original order\", () => pm.expect(pm.response.json().order_id).to.eql(pm.collectionVariables.get(\"order_id\")));",
              "pm.collectionVariables.set(\"replay_body\", pm.response.text());"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Normalized replay",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{client_key}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{request_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/accounts/{{account_id}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"currency\": \"EUR\", \"quantity\": 8, \"side\": \"BUY\", \"instrument\": \"SYNTH-100\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Same response\", () => pm.expect(pm.response.json()).to.deep.eql(JSON.parse(pm.collectionVariables.get(\"replay_body\"))));"
            ]
          }
        }
      ]
    },
