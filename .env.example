# Local development placeholders only. Copy to .env and set a local password.
APP_ENV=development
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql+psycopg://brokerage:replace-with-local-password@127.0.0.1:55432/brokerage_lab

# Distinct local demo identities. Generate private values for .env.
DEMO_API_KEY=replace-with-a-random-demo-key
OTHER_DEMO_API_KEY=replace-with-a-different-random-key

# Local simulator and least-privilege runtime role
APP_DATABASE_PASSWORD=replace-with-random-app-password
PARTNER_DB_PASSWORD=replace-with-random-partner-password
PARTNER_API_KEY=replace-with-random-partner-key
OPERATOR_API_KEY=replace-with-random-operator-key
PARTNER_URL=http://127.0.0.1:8001
